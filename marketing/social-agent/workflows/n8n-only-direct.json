{
  "name": "AppealMate Social - n8n Only Direct Publishing (LOCKED)",
  "id": "amSocialN8nOnly01",
  "nodes": [
    {
      "parameters": {
        "content": "## Simple owner process\n1. Review and approve posts at http://127.0.0.1:3210\n2. Open this workflow to preview due approved posts\n3. Publishing nodes stay disabled until Meta and TikTok credentials are connected\n4. Activate only after a private test succeeds",
        "height": 300,
        "width": 500,
        "color": 5
      },
      "id": "9ccf7894-2718-4a29-b8f0-2b243355d101",
      "name": "OWNER STEPS - N8N ONLY",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -820,
        -340
      ]
    },
    {
      "parameters": {
        "content": "## Credentials still required\nMETA: Facebook Page ID, Instagram Professional Account ID, OAuth/token with pages_manage_posts, pages_read_engagement, instagram_basic and instagram_content_publish.\n\nTIKTOK: approved developer app, video.publish scope, authorized account token/open_id. Unaudited clients can post private-only.\n\nMEDIA: Instagram photos and TikTok photos require URLs on a public/verified domain. Keep all publish nodes disabled until this is configured.",
        "height": 380,
        "width": 560,
        "color": 3
      },
      "id": "0421506a-b298-47f2-90e4-23aa64e30102",
      "name": "CREDENTIAL AND MEDIA GATE",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -170,
        -420
      ]
    },
    {
      "parameters": {},
      "id": "7628da89-5a17-4bb4-b2a7-d0cd289f0103",
      "name": "Preview Due Approved Posts",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -780,
        40
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "54a704ff-8c32-459c-9154-71725e120104",
      "name": "Every 15 Minutes - KEEP INACTIVE",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -780,
        180
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:3210/api/status",
        "options": {}
      },
      "id": "fcd6dbf2-31e2-499e-8887-fc02ea010105",
      "name": "Read Live AppealMate Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const status = $input.first().json;\nif (status?.safeguards?.approvalRequired !== true) throw new Error('Approval safeguard is not enabled');\nif (status?.safeguards?.autoSpend !== false) throw new Error('Auto-spend safeguard is not disabled');\nconst now = Date.now();\nconst root = 'C:/Users/benja/appealmate/marketing/social-agent/';\nconst due = (status.queue || []).filter((item) => item.status === 'approved' && Date.parse(item.scheduledAt) <= now);\nreturn due.flatMap((item) => (item.channels || []).map((channel) => {\n  const asset = item.assets?.[0] || '';\n  const normalized = asset.replaceAll('\\\\', '/').replace(/^.//, '');\n  const fileName = normalized.split('/').pop();\n  return { json: {\n    itemId: item.id,\n    idempotencyKey: `${item.id}:${channel}`,\n    channel,\n    format: item.format,\n    scheduledAt: item.scheduledAt,\n    caption: item.caption,\n    headline: item.headline,\n    destination: item.destination,\n    localAssetPath: root + normalized,\n    publicMediaUrl: '',\n    mediaFileName: fileName,\n    publishLocked: true\n  }};\n}));"
      },
      "id": "a38e5a39-b3cf-4204-9daf-83ad19260106",
      "name": "Safeguard + Due Approved Only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -230,
        100
      ]
    },
    {
      "parameters": {},
      "id": "cff60e4a-9db2-4cd4-8e19-65d78e130107",
